{
  "rewrites": [
    {
      "source": "/media/:path*",
      "destination": "https://hashid-media.guprankoly.workers.dev/:path*"
    },
    {
      "source": "/s/:id",
      "destination": "/api/share?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/media/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ],
"crons": [{ "path": "/api/daily", "schedule": "0 6 * * *" }]
}
