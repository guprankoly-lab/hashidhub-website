rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(uid()));
    }
    function isOwner(id) { return signedIn() && uid() == id; }
    function validText(t, max) { return t is string && t.size() > 0 && t.size() <= max; }
    function memberOf(data) {
      return data.keys().hasAny(['members']) && data.members is list && uid() in data.members;
    }
    function ownsResource(data) {
      return signedIn() && (data.ownerId == uid() || data.uid == uid());
    }
    function publishedOrOwner(data) {
      return data.status == 'published' || (signedIn() && (ownsResource(data) || isAdmin()));
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['admin', 'isAdmin', 'role'])
        && (!('verified' in request.resource.data) || request.resource.data.verified == false);
      allow update: if (isOwner(userId) || isAdmin())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin', 'isAdmin', 'role', 'verified']) || isAdmin());
      allow delete: if isAdmin();
    }
    match /admins/{adminId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /posts/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == uid()
        && request.resource.data.t is string && request.resource.data.t.size() <= 5000
        && (!request.resource.data.keys().hasAny(['official']) || request.resource.data.official == false)
        && (!request.resource.data.keys().hasAny(['ver']) || request.resource.data.ver == get(/databases/$(database)/documents/users/$(uid())).data.verified);
      allow update, delete: if signedIn() && (resource.data.uid == uid() || isAdmin());
    }
    match /comments/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == uid() && validText(request.resource.data.t, 2000);
      allow update, delete: if signedIn() && (resource.data.uid == uid() || isAdmin());
    }
    match /likes/{id} {
      allow read: if true;
      allow create, update: if signedIn() && request.resource.data.uid == uid() && id == request.resource.data.pid + '_' + uid();
      allow delete: if signedIn() && (resource.data.uid == uid() || isAdmin());
    }
    match /savedPosts/{id} {
      allow read: if signedIn() && resource.data.uid == uid();
      allow create: if signedIn() && request.resource.data.uid == uid();
      allow update, delete: if signedIn() && resource.data.uid == uid();
    }
    match /friends/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && (request.resource.data.u1 == uid() || request.resource.data.u2 == uid());
      allow delete: if signedIn() && (resource.data.u1 == uid() || resource.data.u2 == uid() || isAdmin());
      allow update: if false;
    }
    match /friendReqs/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.from == uid();
      allow update, delete: if signedIn() && (resource.data.from == uid() || resource.data.to == uid() || isAdmin());
    }
    match /follows/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.a == uid();
      allow delete: if signedIn() && (resource.data.a == uid() || isAdmin());
      allow update: if false;
    }
    match /blocks/{id} {
      allow read: if signedIn() && (resource == null || resource.data.a == uid() || resource.data.b == uid() || isAdmin());
      allow create: if signedIn() && request.resource.data.a == uid();
      allow delete: if signedIn() && (resource.data.a == uid() || isAdmin());
      allow update: if false;
    }
    match /messages/{id} {
      allow read: if signedIn() && (resource == null || memberOf(resource.data) || isAdmin());
      allow create: if signedIn() && request.resource.data.a == uid() && memberOf(request.resource.data) && validText(request.resource.data.t, 4000);
      allow update: if signedIn() && (memberOf(resource.data) || isAdmin());
      allow delete: if signedIn() && (resource.data.a == uid() || isAdmin());
    }
    match /messageRequests/{id} {
      allow read: if signedIn() && (resource == null || memberOf(resource.data) || isAdmin());
      allow create: if signedIn() && request.resource.data.from == uid() && memberOf(request.resource.data);
      allow update: if signedIn() && (memberOf(resource.data) || isAdmin());
      allow delete: if signedIn() && (resource.data.from == uid() || resource.data.to == uid() || isAdmin());
    }
    match /typing/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.from == uid();
      allow delete: if signedIn() && (resource.data.from == uid() || isAdmin());
    }
    match /notifs/{id} {
      allow read: if signedIn() && (resource.data.to == uid() || isAdmin());
      allow create: if signedIn() && request.resource.data.from == uid() && request.resource.data.keys().hasAll(['to', 'from', 'ts']);
      allow update, delete: if signedIn() && (resource.data.to == uid() || isAdmin());
    }
    match /stories/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == uid();
      allow update, delete: if signedIn() && (resource.data.uid == uid() || isAdmin());
    }
    match /storyViews/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == uid();
      allow update, delete: if isAdmin();
    }
    match /storyReactions/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.uid == uid();
      allow delete: if signedIn() && (resource.data.uid == uid() || isAdmin());
    }
    match /reels/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == uid()
        && (!request.resource.data.keys().hasAny(['official']) || request.resource.data.official == false)
        && (!request.resource.data.keys().hasAny(['ver']) || request.resource.data.ver == get(/databases/$(database)/documents/users/$(uid())).data.verified);
      allow update: if signedIn() && (resource.data.uid == uid() || isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'comments', 'views']));
      allow delete: if signedIn() && (resource.data.uid == uid() || isAdmin());
    }
    match /shares/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == uid()
        && request.resource.data.title.size() <= 120 && request.resource.data.desc.size() <= 300;
      allow update, delete: if signedIn() && resource.data.uid == uid();
    }
    match /pushTokens/{userId} { allow read, write: if signedIn() && userId == uid(); }
    match /askQ/{id} {
      allow read: if signedIn() && (resource.data.to == uid() || resource.data.answered == true || isAdmin());
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['to','t','ts','answered','answer','ansTs'])
        && request.resource.data.answered == false && request.resource.data.to != uid() && validText(request.resource.data.t, 300);
      allow update: if signedIn() && resource.data.to == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer','answered','ansTs']) && validText(request.resource.data.answer, 600);
      allow delete: if signedIn() && (resource.data.to == uid() || isAdmin());
    }
    match /askMeta/{id} {
      allow create: if signedIn() && request.resource.data.from == uid();
      allow read, delete: if isAdmin();
      allow update: if false;
    }
    match /pollVotes/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == uid() && id == request.resource.data.pid + '_' + uid()
        && request.resource.data.opt is int && request.resource.data.opt >= 0 && request.resource.data.opt < 6;
      allow update, delete: if false;
    }
    match /reelLikes/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.uid == uid() && request.resource.data.rid is string && id == request.resource.data.rid + '_' + uid();
      allow delete: if signedIn() && (resource.data.uid == uid() || isAdmin());
    }
    match /reelComments/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == uid() && request.resource.data.rid is string
        && validText(request.resource.data.t, 2000) && request.resource.data.ts is number;
      allow update, delete: if signedIn() && (resource.data.uid == uid() || isAdmin());
    }
    match /pages/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == uid() && (!('verified' in request.resource.data) || request.resource.data.verified == false);
      allow update: if signedIn() && (isAdmin() || (resource.data.owner == uid() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'owner'])));
      allow delete: if signedIn() && (resource.data.owner == uid() || isAdmin());
    }
    match /pageFollows/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == uid();
      allow delete: if signedIn() && (resource.data.uid == uid() || isAdmin());
      allow update: if false;
    }
    match /groups/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == uid();
      allow update: if signedIn() && (isAdmin() || (resource.data.owner == uid() && request.resource.data.owner == resource.data.owner));
      allow delete: if signedIn() && (resource.data.owner == uid() || isAdmin());
    }
    match /groupMembers/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == uid();
      allow update: if signedIn() && (isAdmin() || resource.data.uid == uid() || (resource.data.keys().hasAny(['addedBy']) && resource.data.addedBy == uid()));
      allow delete: if signedIn() && (resource.data.uid == uid() || isAdmin());
    }
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.uid == uid();
      allow read, update, delete: if isAdmin();
    }
    match /banned/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /premium/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /premiumReqs/{id} {
      allow read: if signedIn() && (resource.data.uid == uid() || isAdmin());
      allow create: if signedIn() && request.resource.data.uid == uid();
      allow update, delete: if isAdmin();
    }
    match /ads/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /adstats/{id} {
      allow read: if isAdmin();
      allow create, update: if signedIn() && request.resource.data.uid == uid();
      allow delete: if isAdmin();
    }
    match /adComments/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == uid() && validText(request.resource.data.t, 2000);
      allow update, delete: if signedIn() && (resource.data.uid == uid() || isAdmin());
    }
    match /calls/{id} {
      allow read: if signedIn() && (resource == null || resource.data.from == uid() || resource.data.to == uid() || isAdmin());
      allow create: if signedIn() && request.resource.data.from == uid();
      allow update, delete: if signedIn() && (resource.data.from == uid() || resource.data.to == uid() || isAdmin());
    }
    match /promoteRequests/{id} {
      allow create: if signedIn() && request.resource.data.uid == uid();
      allow read: if signedIn() && (resource.data.uid == uid() || isAdmin());
      allow update, delete: if isAdmin() || (signedIn() && resource.data.uid == uid() && resource.data.status == 'pending');
    }
    match /verifyRequests/{id} {
      allow create: if signedIn() && request.resource.data.uid == uid() && request.resource.data.status == 'pending';
      allow read: if signedIn() && (resource.data.uid == uid() || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Marketplace: public listings are readable; only the publisher may edit/remove them.
    match /marketplace/{id} {
      allow read: if publishedOrOwner(resource.data);
      allow create: if signedIn() && request.resource.data.ownerId == uid()
        && request.resource.data.status in ['draft', 'published'] && validText(request.resource.data.title, 160)
        && request.resource.data.price is number && request.resource.data.price >= 0;
      allow update: if signedIn() && resource.data.ownerId == uid()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','category','price','currency','images','status','updatedAt','location','tags']);
      allow delete: if signedIn() && (resource.data.ownerId == uid() || isAdmin());
    }
    match /products/{id} {
      allow read: if publishedOrOwner(resource.data);
      allow create: if signedIn() && request.resource.data.ownerId == uid() && request.resource.data.status in ['draft','published']
        && validText(request.resource.data.title, 160) && request.resource.data.price is number && request.resource.data.price >= 0;
      allow update: if signedIn() && resource.data.ownerId == uid() && request.resource.data.ownerId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','category','price','currency','images','status','updatedAt','inventory']);
      allow delete: if signedIn() && (resource.data.ownerId == uid() || isAdmin());
    }
    match /services/{id} {
      allow read: if publishedOrOwner(resource.data);
      allow create: if signedIn() && request.resource.data.ownerId == uid() && request.resource.data.status in ['draft','published']
        && validText(request.resource.data.title, 160) && validText(request.resource.data.description, 4000);
      allow update: if signedIn() && resource.data.ownerId == uid() && request.resource.data.ownerId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','category','price','currency','images','status','updatedAt','duration']);
      allow delete: if signedIn() && (resource.data.ownerId == uid() || isAdmin());
    }
    match /jobPosts/{id} {
      allow read: if publishedOrOwner(resource.data);
      allow create: if signedIn() && request.resource.data.ownerId == uid() && request.resource.data.status in ['draft','published']
        && validText(request.resource.data.title, 160) && validText(request.resource.data.description, 6000);
      allow update: if signedIn() && resource.data.ownerId == uid() && request.resource.data.ownerId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','company','location','employmentType','category','salaryRange','status','updatedAt','skills']);
      allow delete: if signedIn() && (resource.data.ownerId == uid() || isAdmin());
    }
    match /applications/{id} {
      allow create: if signedIn() && request.resource.data.applicantId == uid()
        && request.resource.data.status == 'submitted' && validText(request.resource.data.jobId, 128);
      allow read: if signedIn() && (resource.data.applicantId == uid() || resource.data.ownerId == uid() || isAdmin());
      allow update: if signedIn() && ((resource.data.ownerId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt']))
        || (resource.data.applicantId == uid() && resource.data.status == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['withdrawnAt','status']) && request.resource.data.status == 'withdrawn'));
      allow delete: if isAdmin();
    }
    match /courses/{id} {
      allow read: if publishedOrOwner(resource.data);
      allow create: if signedIn() && request.resource.data.ownerId == uid() && request.resource.data.status in ['draft','published']
        && validText(request.resource.data.title, 180) && validText(request.resource.data.description, 5000);
      allow update: if signedIn() && resource.data.ownerId == uid() && request.resource.data.ownerId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','category','language','level','coverUrl','status','updatedAt','certificateEnabled']);
      allow delete: if signedIn() && (resource.data.ownerId == uid() || isAdmin());
    }
    match /lessons/{id} {
      allow read: if resource.data.status == 'published' || (signedIn() && (resource.data.ownerId == uid() || isAdmin()));
      allow create: if signedIn() && request.resource.data.ownerId == uid() && validText(request.resource.data.courseId, 128)
        && validText(request.resource.data.title, 180);
      allow update: if signedIn() && resource.data.ownerId == uid() && request.resource.data.ownerId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','body','videoUrl','order','status','updatedAt']);
      allow delete: if signedIn() && (resource.data.ownerId == uid() || isAdmin());
    }
    match /achievements/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    // XP and streak awards are server/admin-only to prevent client-side self-awarding.
    match /xp/{id} {
      allow read: if signedIn() && (resource.data.uid == uid() || isAdmin());
      allow create, update, delete: if isAdmin();
    }
    match /creatorFund/{id} {
      allow read: if signedIn() && (resource.data.uid == uid() || isAdmin());
      allow create, update, delete: if isAdmin();
    }
    match /verificationRequests/{id} {
      allow create: if signedIn() && request.resource.data.uid == uid() && request.resource.data.status == 'pending'
        && request.resource.data.type in ['creator','business','organization'];
      allow read: if signedIn() && (resource.data.uid == uid() || isAdmin());
      allow update, delete: if isAdmin();
    }
    match /businessAccounts/{id} {
      allow read: if signedIn() && (resource.data.ownerId == uid() || resource.data.visibility == 'public' || isAdmin());
      allow create: if signedIn() && request.resource.data.ownerId == uid()
        && (!request.resource.data.keys().hasAny(['verified']) || request.resource.data.verified == false);
      allow update: if signedIn() && (isAdmin() || (resource.data.ownerId == uid() && request.resource.data.ownerId == uid()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified','verificationStatus','ownerId'])));
      allow delete: if signedIn() && (resource.data.ownerId == uid() || isAdmin());
    }

    match /{document=**} { allow read, write: if false; }
  }
}
